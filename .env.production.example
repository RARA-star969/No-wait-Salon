# Embedded into each Android web bundle at build time. Must be HTTPS.
VITE_API_BASE_URL=https://no-wait-salon-api.onrender.com

# Backend runtime configuration (set these in the cloud dashboard).
NODE_ENV=production
DATA_DIR=/data
ALLOWED_ORIGINS=capacitor://localhost,http://localhost

# Set as protected cloud secrets. Prefer ADMIN_PASSWORD_HASH after initial setup.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=generated-scrypt-hash
